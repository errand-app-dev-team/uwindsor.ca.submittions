#You have to use your api secret key hash peeper in your .env
# file in order to use this while running the project, also make enable_demo_quotes=true

API_KEY_HASH_PEPPER=your-secret-pepper
ENABLE_DEMO_QUOTES=false
WEBHOOK_ENCRYPTION_KEY=your-generated-encryption-key
DJANGO_SECRET_KEY=your_generated_secret_key_here

#only for development env
DJANGO_DEBUG=True